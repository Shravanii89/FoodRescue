# ========================================================================
# FoodRescue Client Environment Variables (Frontend Deployment on Vercel)
# ========================================================================

# The production URL of your backend deployed on Render (include /api or base URL)
# Example: VITE_API_URL=https://foodrescue-api.onrender.com/api
# In local development, leave this empty to use the Vite proxy forwarding to http://localhost:5000
VITE_API_URL=
