{
  "name": "foodrescue-monorepo",
  "version": "1.0.0",
  "description": "FoodRescue - Smart Surplus Food Redistribution & Donation Management System",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "start": "npm start --prefix server",
